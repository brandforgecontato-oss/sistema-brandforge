# Pasta de dados FORA do OneDrive (banco + vídeos). Criada automaticamente.
DATA_DIR=C:\BrandForge-dados

# Pasta que contém os projetos BrandForge (site, linktree, prospecção...).
# Se omitida, usa a pasta-mãe deste projeto.
# PROJECTS_ROOT=C:\caminho\para\BrandForge

# Projetos cujo código fica fora dessa pasta (nome-da-pasta=caminho; separados por ";")
# PROJECT_CODE_DIRS=brandforge-site-oficial=C:\Users\voce\GitHub\brandforge-site

# Intervalo da busca automática de tendências pelo worker (minutos)
TRENDS_INTERVAL_MIN=180

# --- Pipeline de vídeo (tudo opcional: o painel acha sozinho) ---
# FFMPEG_BIN / FFPROBE_BIN / YTDLP_BIN  -> padrão: pacotes do winget
# WHISPER_BIN    -> padrão: DATA_DIR\ferramentas\whisper\Release\whisper-cli.exe
# WHISPER_MODEL  -> padrão: DATA_DIR\ferramentas\modelos\ggml-large-v3-turbo-q5_0.bin
# WHISPER_PROMPT -> vocabulário inicial para a transcrição
# CLAUDE_BIN     -> padrão: claude.exe da extensão do VS Code (usa sua assinatura)
# CLAUDE_MODEL=sonnet

# B-roll (imagens/vídeos de apoio) do banco gratuito Pexels. Chave grátis em https://www.pexels.com/api/
# Sem a chave, o Claude ainda escolhe os momentos, mas nada é baixado.
# PEXELS_API_KEY=
